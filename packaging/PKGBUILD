# Maintainer: baakhoff <https://github.com/baakhoff/BiD>
pkgname=bid
pkgver=0.2.2
pkgrel=1
pkgdesc="Mixer control panel for Audient iD audio interfaces"
arch=('x86_64')
url="https://github.com/baakhoff/BiD"
license=('MIT')
depends=('glfw' 'libusb' 'libglvnd' 'systemd-libs')
makedepends=('cmake' 'gcc' 'make' 'pkgconf')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('2c404d252d7cd682b71f925531ba1d17fc2e4fe6fc285a3c95fab5a7b8b1d652')

build() {
	cmake -B build -S "BiD-$pkgver" \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}
